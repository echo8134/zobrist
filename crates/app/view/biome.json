{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["**", "!dist", "!src/generated"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@tauri-apps/api", "@tauri-apps/api/*"],
                "message": "Call Rust through src/ipc.ts. No other file of the view imports the Tauri API."
              },
              {
                "group": [
                  "@lichess-org/chessground",
                  "@lichess-org/chessground/**"
                ],
                "message": "Draw a board through src/board/Board.tsx. No other file of the view imports the board component."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ipc.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@lichess-org/chessground",
                      "@lichess-org/chessground/**"
                    ],
                    "message": "Draw a board through src/board/Board.tsx. No other file of the view imports the board component."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/board/Board.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/api", "@tauri-apps/api/*"],
                    "message": "Call Rust through src/ipc.ts. No other file of the view imports the Tauri API."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
